    }
    tool_call_output_tokens: 1399
    model_info {
      model_name: "gemini-3.8-flash"
      thinking_budget: 4000
    }
    tool_summary: "Create Flask application for staff tracking"
    tool_action: "Create app.py"
    started_at {
      seconds: 1788366598
      nanos: 56154603
    }
  }
  file_change {
    absolute_path_uri: "file:///app.py"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\"\"\"\nRajalakshmi Institute of Technology (RIT)\nStaff Location Attendance / Presence Tracking - Dummy Prototype\n\nRun with:\n    pip install -r requirements.txt\n    python app.py\n\"\"\"\n\nimport os\nfrom datetime import datetime\nfrom flask import Flask, render_template, request, jsonify, redirect, url_for, session\nfrom openpyxl import Workbook, load_workbook\nfrom geofence import detect_location\n\napp = Flask(__name__)\napp.secret_key = os.environ.get(\"SECRET_KEY\", \"rit-attendance-dummy-secret-key-2026\")\n\n# DEMO / DUMMY CREDENTIALS\n# For demonstration purposes only.\nDUMMY_STAFF = {\n    \"STAFF001\": \"staff123\",\n    \"STAFF002\": \"staff123\",\n    \"STAFF003\": \"staff123\",\n}\n\nEXCEL_FILE = os.path.join(os.path.dirname(__file__), \"staff_presence.xlsx\")\n\n# Track staff members who have already pushed during the prototype run\n# Also synced with the records in the Excel file\nalready_pushed_staff = set()\n\n\ndef init_excel_file():\n    \"\"\"Ensure the staff_presence.xlsx file exists with appropriate headers.\"\"\"\n    if not os.path.exists(EXCEL_FILE):\n        wb = Workbook()\n        ws = wb.active\n        ws.title = \"Staff Presence\"\n        ws.append([\"Staff ID\", \"Timestamp\", \"Latitude\", \"Longitude\", \"Location\"])\n        wb.save(EXCEL_FILE)\n    else:\n        # Load existing staff IDs to prevent duplicates on server restart\n        try:\n            wb = load_workbook(EXCEL_FILE)\n            ws = wb.active\n            for row in ws.iter_rows(min_row=2, values_only=True):\n                if row and row[0]:\n                    already_pushed_staff.add(str(row[0]).strip().upper())\n        except Exception as e:\n            print(f\"Error inspecting Excel file: {e}\")\n\n\ndef append_excel_record(staff_id, timestamp, latitude, longitude, location):\n    \"\"\"Append a new presence record row to the Excel file.\"\"\"\n    if not os.path.exists(EXCEL_FILE):\n        init_excel_file()\n\n    wb = load_workbook(EXCEL_FILE)\n    ws = wb.active\n    ws.append([staff_id, timestamp, latitude, longitude, location])\n    wb.save(EXCEL_FILE)\n\n\n# Initialize on startup\ninit_excel_file()\n\n\n@app.route(\"/\")\ndef index():\n    \"\"\"Redirect to staff login or staff screen.\"\"\"\n    if \"staff_id\" in session:\n        return redirect(url_for(\"staff_screen\"))\n    return redirect(url_for(\"login\"))\n\n\n@app.route(\"/login\", methods=[\"GET\", \"POST\"])\ndef login():\n    \"\"\"Staff Login Page.\"\"\"\n    if request.method == \"POST\":\n        staff_id = request.form.get(\"staff_id\", \"\").strip().upper()\n        password = request.form.get(\"password\", \"\").strip()\n\n        if staff_id in DUMMY_STAFF and DUMMY_STAFF[staff_id] == password:\n            session[\"staff_id\"] = staff_id\n            return redirect(url_for(\"staff_screen\"))\n        else:\n            return render_template(\"login.html\", error=\"Invalid Staff ID or Password\")\n\n    return render_template(\"login.html\")\n\n\n@app.route(\"/staff\")\ndef staff_screen():\n    \"\"\"\n    Staff Screen:\n    Contains ONLY:\n    Staff ID above the button.\n    NO navigation bar, NO dashboard, NO menu, NO profile, NO history,\n    NO location info, NO timestamp shown, NO admin controls.\n    \"\"\"\n    if \"staff_id\" not in session:\n        return redirect(url_for(\"login\"))\n\n    staff_id = session[\"staff_id\"]\n    has_pushed = staff_id in already_pushed_staff\n\n    return render_template(\"staff.html\", staff_id=staff_id, has_pushed=has_pushed)\n\n\n@app.route(\"/api/push\", methods=[\"POST\"])\ndef api_push():\n    \"\"\"\n    API endpoint for staff PUSH action:\n    - Validates logged-in session\n    - Prevents multiple pushes\n    - Validates GPS coordinates\n    - Detects campus zone\n    - Generates server timestamp\n    - Appends record to staff_presence.xlsx\n    \"\"\"\n    if \"staff_id\" not in session:\n        return jsonify({\"success\": False, \"error\": \"Not authenticated\"}), 401\n\n    staff_id = session[\"staff_id\"]\n\n    # Prevent multiple pushes (server-side check)\n    if staff_id in already_pushed_staff:\n        return jsonify({\"success\": False, \"error\": \"Push already recorded for this staff member.\"}), 400\n\n    data = request.get_json() or {}\n    latitude = data.get(\"latitude\")\n    longitude = data.get(\"longitude\")\n\n    if latitude is None or longitude is None:\n        return jsonify({\"success\": False, \"error\": \"Location coordinates required\"}), 400\n\n    try:\n        lat = float(latitude)\n        lon = float(longitude)\n    except (ValueError, TypeError):\n        return jsonify({\"success\": False, \"error\": \"Invalid coordinates format\"}), 400\n\n    # Geofence detection\n    location_name = detect_location(lat, lon)\n\n    # Server-generated timestamp: YYYY-MM-DD HH:MM:SS\n    timestamp = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n\n    # Record push\n    try:\n        append_excel_record(staff_id, timestamp, lat, lon, location_name)\n        already_pushed_staff.add(staff_id)\n        return jsonify({\"success\": True, \"status\": \"PUSHED\"})\n    except Exception as e:\n        return jsonify({\"success\": False, \"error\": f\"Failed to save record: {str(e)}\"}), 500\n\n\n@app.route(\"/logout\")\ndef logout():\n    session.clear()\n    return redirect(url_for(\"login\"))\n\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=3000, debug=False)\n"
    }
