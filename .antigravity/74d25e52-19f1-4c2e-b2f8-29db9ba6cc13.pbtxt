  file_change {
    absolute_path_uri: "file:///static/style.css"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif;\n  background-color: #f8fafc;\n  color: #0f172a;\n  min-height: 100vh;\n}\n\n/* -------------------------------------------\n   Staff Screen (Ultra-Minimalist)\n------------------------------------------- */\n.staff-body {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100vh;\n  width: 100vw;\n  overflow: hidden;\n  background: #ffffff;\n}\n\n.staff-center-wrapper {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n}\n\n.staff-id-display {\n  font-size: 1.85rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: #1e293b;\n  margin-bottom: 2.5rem;\n  user-select: none;\n}\n\n.push-btn {\n  width: 220px;\n  height: 64px;\n  font-size: 1.35rem;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  color: #ffffff;\n  background-color: #0284c7;\n  border: none;\n  border-radius: 12px;\n  cursor: pointer;\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.push-btn:hover:not(:disabled) {\n  background-color: #0369a1;\n  transform: translateY(-2px);\n  box-shadow: 0 6px 16px rgba(2, 132, 199, 0.35);\n}\n\n.push-btn:active:not(:disabled) {\n  transform: translateY(0);\n}\n\n.push-btn:disabled,\n.push-btn.pushed {\n  background-color: #94a3b8;\n  color: #f1f5f9;\n  cursor: not-allowed;\n  transform: none;\n  box-shadow: none;\n}\n\n.status-msg {\n  margin-top: 1.25rem;\n  font-size: 0.9rem;\n  font-weight: 500;\n  color: #ef4444;\n  min-height: 1.25rem;\n}\n\n/* -------------------------------------------\n   Login Screen\n------------------------------------------- */\n.login-body {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  padding: 1.5rem;\n  background: #f1f5f9;\n}\n\n.login-container {\n  width: 100%;\n  max-width: 380px;\n  background: #ffffff;\n  padding: 2.25rem;\n  border-radius: 14px;\n  border: 1px solid #e2e8f0;\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);\n}\n\n.login-header {\n  text-align: center;\n  margin-bottom: 1.75rem;\n}\n\n.login-header h2 {\n  font-size: 1.35rem;\n  font-weight: 700;\n  color: #0f172a;\n}\n\n.subtitle {\n  font-size: 0.85rem;\n  color: #64748b;\n  margin-top: 0.25rem;\n}\n\n.error-banner {\n  background: #fef2f2;\n  border: 1px solid #fecaca;\n  color: #dc2626;\n  font-size: 0.85rem;\n  padding: 0.6rem 0.75rem;\n  border-radius: 8px;\n  margin-bottom: 1.25rem;\n  text-align: center;\n}\n\n.login-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1.15rem;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 0.4rem;\n  text-align: left;\n}\n\n.form-group label {\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: #334155;\n}\n\n.form-group input {\n  padding: 0.75rem 0.9rem;\n  font-size: 0.95rem;\n  border: 1px solid #cbd5e1;\n  border-radius: 8px;\n  outline: none;\n  transition: border-color 0.15s ease;\n}\n\n.form-group input:focus {\n  border-color: #0284c7;\n  box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);\n}\n\n.submit-btn {\n  margin-top: 0.5rem;\n  padding: 0.8rem;\n  font-size: 1rem;\n  font-weight: 600;\n  color: #ffffff;\n  background-color: #0284c7;\n  border: none;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: background-color 0.15s ease;\n}\n\n.submit-btn:hover {\n  background-color: #0369a1;\n}\n\n.demo-credentials-card {\n  margin-top: 1.75rem;\n  padding: 0.85rem;\n  background: #f8fafc;\n  border: 1px dashed #cbd5e1;\n  border-radius: 8px;\n  font-size: 0.8rem;\n  color: #475569;\n  text-align: center;\n}\n\n.demo-tag {\n  font-size: 0.68rem;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  color: #0369a1;\n  margin-bottom: 0.35rem;\n}\n\n.demo-credentials-card code {\n  background: #e2e8f0;\n  padding: 0.1rem 0.3rem;\n  border-radius: 4px;\n  font-weight: 600;\n  color: #0f172a;\n}\n\n.demo-sub {\n  margin-top: 0.25rem;\n  color: #64748b;\n}\n"
    }
