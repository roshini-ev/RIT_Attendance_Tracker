<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RITAttendanceTracker" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/rit_blue</item>
        <item name="colorPrimaryVariant">@color/rit_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/rit_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/rit_blue_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.RITAttendanceTracker.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/rit_blue_dark</item>
        <item name="android:navigationBarColor">@color/rit_blue_dark</item>
    </style>
</resources>
